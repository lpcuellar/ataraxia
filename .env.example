# Copiar a .env y llenar con valores reales. Nunca commitear .env con secretos reales.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Datos financieros: Financial Modeling Prep ---
FMP_API_KEY=

# --- Base de datos: Supabase (Postgres), conexion directa con el rol ataraxia_brain ---
# Correr src/db/schema.sql en el SQL Editor de Supabase primero (crea las tablas, RLS, y
# el rol). El host esta en Settings > Database > Connection string de tu proyecto.
# La password es la que pusiste al reemplazar el placeholder en la linea "create role" de
# schema.sql — no la password de tu cuenta de Supabase.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=ataraxia_brain
SUPABASE_DB_PASSWORD=

# --- Rol de DB del executor (separado del brain — ver supabase/migrations/..._executor_tables.sql)
# Crear a mano en el SQL Editor: create role ataraxia_executor login password '...';
# Con el session pooler el usuario lleva el sufijo del project ref, igual que el brain.
EXECUTOR_DB_USER=ataraxia_executor.jvrjkvatveuxzrkwzszu
EXECUTOR_DB_PASSWORD=

# --- WhatsApp (Meta Cloud API) — notificaciones del executor ---
# Setup en developers.facebook.com: app -> WhatsApp -> numero de prueba -> token permanente
# de system user -> template de utilidad aprobado. Ver src/executor/notifier.py.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=            # tu numero, E.164 sin '+', p.ej. 502XXXXXXXX
WHATSAPP_TEMPLATE_NAME=ataraxia_update
WHATSAPP_TEMPLATE_LANG=es

# --- Interactive Brokers (Client Portal API vía IBeam, cuenta PAPER) ---
# Credenciales de la cuenta de paper trading (sin 2FA — por eso es automatizable).
# Las usa SOLO el contenedor de IBeam (docker/docker-compose.yml), nunca el brain.
IBKR_PAPER_USERNAME=
IBKR_PAPER_PASSWORD=
IBKR_ACCOUNT_ID=
IBKR_PAPER_TRADING=true
IBEAM_GATEWAY_PORT=5000

# --- General ---
ATARAXIA_ENV=development   # development | paper | production
LOG_LEVEL=INFO
