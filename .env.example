# Copiar a .env y llenar con valores reales. Nunca commitear .env con secretos reales.

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Datos financieros: Financial Modeling Prep ---
FMP_API_KEY=

# --- Base de datos: Supabase (Postgres), conexion directa con el rol ataraxia_brain ---
# Correr src/db/schema.sql en el SQL Editor de Supabase primero (crea las tablas, RLS, y
# el rol). El host esta en Settings > Database > Connection string de tu proyecto.
# La password es la que pusiste al reemplazar el placeholder en la linea "create role" de
# schema.sql — no la password de tu cuenta de Supabase.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=ataraxia_brain
SUPABASE_DB_PASSWORD=

# --- Interactive Brokers (Client Portal API vía IBeam/ibind) ---
# El Gateway corre localmente; estas variables configuran el wrapper de autenticación.
IBKR_ACCOUNT_ID=
IBKR_PAPER_TRADING=true
IBEAM_GATEWAY_PORT=5000

# --- General ---
ATARAXIA_ENV=development   # development | paper | production
LOG_LEVEL=INFO
