FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY config/ config/

# El executor corre una vez por invocacion (lo agenda el host con cron/launchd o el
# scheduler del compose) — no es un daemon.
CMD ["python", "-m", "src.executor.run_executor"]
