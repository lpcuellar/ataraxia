# Conexion de solo lectura a Supabase (rol ataraxia_dashboard — ver
# supabase/migrations/20261014180000_dashboard_readonly_role.sql). Mismo host que
# ataraxia_brain usa en el repo Python (.env en la raiz), distinto usuario y password.
#
# OJO con el usuario: el pooler de Supabase (Supavisor) identifica el proyecto por el
# nombre de usuario, no por el host (el host es compartido entre todos los proyectos de
# la region). El formato es "<rol>.<project_ref>" — ver SUPABASE_DB_USER en el .env de la
# raiz del repo para el project_ref real (es el mismo para todos los roles del proyecto).
# Sin el sufijo, Supabase rechaza la conexion con "no tenant identifier provided".
DASHBOARD_DB_HOST=aws-0-us-east-2.pooler.supabase.com
DASHBOARD_DB_PORT=5432
DASHBOARD_DB_NAME=postgres
DASHBOARD_DB_USER=ataraxia_dashboard.<project_ref>
DASHBOARD_DB_PASSWORD=

# Password que pide el login del dashboard antes de mostrar cualquier dato. Elegila vos,
# no la generes al azar como la de arriba — la vas a tener que escribir en el navegador.
DASHBOARD_PASSWORD=

# Secreto para firmar la cookie de sesion despues del login. Genera uno con:
#   openssl rand -base64 32
SESSION_SECRET=
